{
  "opencollection": "1.0.0",
  "info": {
    "name": "Merchant API Report",
    "version": "3.0.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "x-auth-report-api-key",
      "value": "{{x-auth-report-api-key}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Order status",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "postorder-status",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "http://127.0.0.1:10010/v3/order-status",
            "body": {
              "type": "json",
              "data": "{}"
            }
          }
        }
      ]
    },
    {
      "info": {
        "name": "Disputes",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "postdisputes",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "http://127.0.0.1:10010/v3/disputes",
            "body": {
              "type": "json",
              "data": "{}"
            }
          }
        }
      ]
    },
    {
      "info": {
        "name": "Transactions",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "posttransactions",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "http://127.0.0.1:10010/v3/transactions",
            "body": {
              "type": "json",
              "data": "{}"
            }
          }
        }
      ]
    },
    {
      "info": {
        "name": "Processing accounts",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "postprocessing-accounts",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "http://127.0.0.1:10010/v3/processing-accounts",
            "body": {
              "type": "json",
              "data": "{}"
            }
          }
        }
      ]
    }
  ],
  "bundled": true
}