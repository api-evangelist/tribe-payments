              "status": "OK",
              "code": 200,
              "header": [
                {
                  "key": "Content-Type",
                  "value": "application/json"
                }
              ],
              "body": "{\n  \"callbackUrl\": \"https://tpp.example.com/signed\",\n  \"accessToken\": \"$#@%#$%^$@#$56445641653!@#$%3\",\n  \"validUntil\": \"2020-10-13T12:54:58+00:00\"\n}",
              "cookie": [],
              "_postman_previewlanguage": "json"
            }
          ],
          "event": [],
