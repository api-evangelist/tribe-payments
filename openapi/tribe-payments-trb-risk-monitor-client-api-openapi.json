            "nullable": false
          },
          "state": {
            "type": "string",
            "description": "Event data state.",
            "enum": ["PROCESSING", "MANUAL_PROCESSING", "MANUAL_REPROCESSING", "RETRIGGER", "INTEGRATION_RETRIGGER", "COMPLETED"],
            "nullable": false
          },
          "data": {
            "type": "object",
