            "format": "date-time",
            "nullable": false
          },
          "updatedAt": {
            "type": "string",
            "description": "Date when the event data was last updated. ISO 8601 format: `YYYY-MM-DDTHH:mm:ss.SSSZ`",
            "format": "date-time",
            "nullable": true
