            "Prepare": {
                "title": "prepare",
                "properties": {
                    "webhook": {
                        "$ref": "#/components/schemas/PrepareWebhook"
                    },
                    "requestId": {
                        "description": "Unique request ID received after a successful initial request for the appropriate action",
                        "type": "string",
                        "example": "bdc84215-d2ed-4e39-b4dd-e7b3ba85e38b",
                        "maxLength": 36,
                        "minLength": 36
                    },
                    "redirectUrl": {
                        "description": "URL with redirect link",
                        "type": "string",
                        "example": "https://example-url.gateway.com/2a731e2ddfebc14ca4834e44851fda59",
                        "maxLength": 255,
                        "minLength": 1
                    }
                },
                "type": "object",
                "required": [
                    "requestId",
                    "redirectUrl"
                ]
            },
            "PrepareWebhook": {
                "type": "object",
                "properties": {
                    "id": {
                        "description": "Unique webhook ID",
                        "type": "string",
                        "example": "5455223499197002",
                        "maxLength": 16,
                        "minLength": 16
                    },
                    "type": {
                        "description": "[Webhook Type] hosted_payment_prepare",
                        "type": "string",
                        "example": "hosted_payment_prepare",
                        "maxLength": 50,
                        "minLength": 1
                    }
                },
                "required": [
                    "id",
                    "type"
                ]
            },
