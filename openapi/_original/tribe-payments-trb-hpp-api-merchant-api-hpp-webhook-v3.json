{
    "openapi": "3.0.0",
    "info": {
        "title": "Merchant API HPP Webhook",
        "version": "3.0.0",
        "description": "Merchant API HPP Webhook"
    },
    "servers": [
        {
            "url": "http://127.0.0.1:10010/v3"
        }
