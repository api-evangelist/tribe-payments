            "description": "The successful response.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PaymentSingleResponse"
                }
              }
            }
          },
          "302": {
            "description": "Callback URL parameters for redirect after the user accesses `confirmation_url` and BANK performs redirect to `callback_url` from request content:\n.",
            "content": {
