            "nullable": false,
            "example": "KX2ooE/kCxGSNxCtZlVw9AJd+TfqXZm5fqC4khzms28rHBPheKkreOQhQL95ms8RE0oAF86ZwB1OY+4o//qTlw=="
          },
          "required": true
        }
      ]
    },
